{
  "name": "testball-qa",
  "version": "1.0.0",
  "private": true,
  "description": "TestBall QA — система управления тестированием: тест-кейсы, прогоны, баги",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "migrate": "node server/migrate.js",
    "import": "node scripts/import.js",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "dev:web": "npm --prefix web run dev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "ldapts": "8.2.0",
    "pg": "^8.13.1"
  }
}
