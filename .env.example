# Скопируйте этот файл в .env и задайте свои значения.

# Пароль базы данных PostgreSQL. Придумайте длинный случайный (20+ символов).
POSTGRES_PASSWORD=замените-на-длинный-случайный-пароль

# Порт, на котором приложение будет доступно на этом компьютере: http://localhost:3000
APP_PORT=3000
# С каких адресов принимать соединения. 127.0.0.1 — только с этого компьютера (туннель, прокси, Tailscale serve).
# 0.0.0.0 — ещё и из локальной сети (вариант А в README); тогда задайте и TRUST_PROXY=false
APP_BIND=127.0.0.1
# Кому верить в заголовке X-Forwarded-For (настоящий IP посетителя за прокси). Пусто — прокси на этом компьютере
# и в Docker. false — никому: приложение открыто напрямую, и подделанный заголовок обходил бы лимиты попыток входа
TRUST_PROXY=

# Регистрация: open — каждый может зарегистрироваться (роль «Разработчик» без проектов, ждёт админа);
# closed — учётные записи создаёт только админ в разделе «Пользователи». Для доступа из интернета рекомендуется closed
REGISTRATION=open
# Код для регистрации первого администратора в пустой базе. Пусто — случайный, печатается в логах: docker compose logs app
SETUP_CODE=

# Максимальный размер одного вложения (скриншота, лога), МБ
MAX_UPLOAD_MB=20

# Токен Cloudflare Tunnel — только если открываете доступ из интернета через Cloudflare (шаг 2Б в README)
CLOUDFLARE_TUNNEL_TOKEN=

# Логин администратора. При каждом запуске этот пользователь становится админом и разблокируется.
# Нужно, если админа нет или он потерял доступ. Указывайте только существующий логин: зарегистрировать его заново нельзя.
# Обычно пусто: роли выдаются в разделе «Пользователи»
ADMIN_LOGIN=

# Языковая модель (необязательно, часть 4 в README). В поставку модель не входит: администратор подключает
# облачный сервис (Anthropic Claude, YandexGPT, GigaChat, OpenAI-совместимые API) или свою модель
# в интерфейсе: «Настройки» → «Языковая модель». Ключи хранятся в базе зашифрованными.
# false — разрешить только свои модели внутри периметра: тексты багов и кейсов не уйдут во внешние сервисы
LLM_ALLOW_CLOUD=true
# Запросов к модели на одного пользователя за 10 минут
LLM_USER_LIMIT=20
# Для совместимости со старыми установками: своя модель по OpenAI-совместимому API без настройки в интерфейсе.
# Действует, только пока в интерфейсе не выбрано активное подключение. Обычно пусто
LLM_URL=
LLM_MODEL=
LLM_API_KEY=

# ---------------- Корпоративная установка (README, часть 5) ----------------
# Адрес, по которому TestBall открывают пользователи: ссылки в вебхуках, адрес возврата SSO, TESTBALL_URL для CI
PUBLIC_URL=
# Длинная случайная строка (32+ символа): шифрует токены трекеров, CI и секреты вебхуков в базе. Задайте один раз и не меняйте
APP_SECRET=

# Вход по локальному паролю: on — да; off — только SSO/LDAP (локальный пароль остаётся лишь у ADMIN_LOGIN на аварийный случай)
LOCAL_LOGIN=on

# --- LDAP / Active Directory: вход доменным логином и паролем ---
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# {{login}} — введённый логин. По умолчанию ищется по sAMAccountName, userPrincipalName или uid
LDAP_USER_FILTER=
LDAP_STARTTLS=false
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_CA_FILE=
# Учитывать вложенные группы AD
LDAP_NESTED_GROUPS=false

# --- OpenID Connect (Keycloak, ADFS, Azure AD / Entra ID, Okta, Яндекс ID …) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Пусто — PUBLIC_URL/api/auth/oidc/callback (зарегистрируйте этот адрес в IdP)
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_LOGIN_CLAIM=preferred_username
OIDC_GROUPS_CLAIM=groups
OIDC_LABEL=Войти через SSO

# --- Kerberos (SPNEGO): билет проверяет обратный прокси и передаёт имя пользователя в заголовке ---
KERBEROS_USER_HEADER=
KERBEROS_GROUPS_HEADER=
# Общий секрет прокси → TestBall (заголовок X-Auth-Proxy-Secret). Без него вход через Kerberos выключен
KERBEROS_PROXY_SECRET=

# --- Группы каталога / IdP → роли (через «;», CN или полный DN) ---
SSO_ADMIN_GROUPS=
SSO_TESTER_GROUPS=
SSO_DEVELOPER_GROUPS=
SSO_VIEWER_GROUPS=
# Роль нового пользователя, если ни одна группа не подошла: viewer | developer | tester
SSO_DEFAULT_ROLE=viewer
# Пускать только членов этих групп (пусто — всех)
SSO_REQUIRED_GROUPS=
# Доступ к проектам из групп, например ^TB-([A-Z]{2,6})(?:-(tester|developer|viewer))?$$
# (в этом файле «$» пишется как «$$» — иначе Docker Compose примет его за подстановку переменной)
SSO_PROJECT_GROUP_RE=

# --- Лицензии: пусто — без ограничений ---
# Полные места (тестировщики и администраторы) и просмотровые (разработчики и наблюдатели)
LICENSE_FULL_SEATS=
LICENSE_VIEW_SEATS=

# --- Хранилище вложений: local (том Docker) или s3 (MinIO, Ceph, Yandex Object Storage, AWS) ---
STORAGE=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# --- Нестабильные автотесты: окно (запусков), минимум запусков для вердикта по флипам, порог 0–1 ---
FLAKY_WINDOW=20
FLAKY_MIN_RUNS=4
FLAKY_THRESHOLD=0.3

# --- Вебхуки: запретить адреса внутренней сети (true для облачной установки) ---
WEBHOOK_BLOCK_PRIVATE=false
# Максимальный размер файла импорта проекта, МБ
IMPORT_MAX_MB=200
