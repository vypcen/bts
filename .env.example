# Скопируйте этот файл в .env и задайте свои значения.

# Пароль базы данных PostgreSQL. Придумайте длинный случайный (20+ символов).
POSTGRES_PASSWORD=замените-на-длинный-случайный-пароль

# Порт, на котором приложение будет доступно на этом компьютере: http://localhost:3000
APP_PORT=3000

# Максимальный размер одного вложения (скриншота, лога), МБ
MAX_UPLOAD_MB=20

# Токен Cloudflare Tunnel — только если открываете доступ из интернета через Cloudflare (шаг 2Б в README)
CLOUDFLARE_TUNNEL_TOKEN=

# Логин администратора. При каждом запуске этот пользователь становится админом и разблокируется.
# Нужно, если админа нет или он потерял доступ. Обычно пусто: роли выдаются в разделе «Пользователи»
ADMIN_LOGIN=

# Локальная языковая модель (необязательно, часть 4 в README). Пусто — функции с моделью выключены.
# Модель в Docker (docker compose --profile llm up -d): http://ollama:11434/v1
# Ollama, установленная прямо в Windows/macOS (быстрее с видеокартой): http://host.docker.internal:11434/v1
LLM_URL=
# Имя модели. qwen2.5:3b — ~2 ГБ, нужно 4+ ГБ свободной памяти; для слабого компьютера qwen2.5:1.5b
LLM_MODEL=qwen2.5:3b
# Сколько ждать ответа модели, мс. Без видеокарты ответ может идти минуту и дольше
LLM_TIMEOUT_MS=120000
