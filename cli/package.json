{
  "name": "@testball/cli",
  "version": "1.1.0",
  "description": "testbolctl — загрузка результатов автотестов (JUnit XML, allure-results) в TestBall QA и управление запусками из CI",
  "bin": { "testbolctl": "bin/testbolctl.js" },
  "files": ["bin", "lib", "README.md"],
  "engines": { "node": ">=20" },
